# Token do bot (peça ao @BotFather no Telegram)
TELEGRAM_TOKEN=

# IDs autorizados, separados por vírgula (descubra o seu com @userinfobot)
# Use "*" para liberar para qualquer usuário (cuidado: bot fica público!)
ALLOWED_USER_IDS=123456789,987654321

# Altura máxima de vídeo oferecida (1080, 720, 480, 360)
MAX_HEIGHT=720

# ----- Opcional: server Bot API local para arquivos até 2 GB -----
# Obtenha api_id e api_hash em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
