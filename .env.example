# Token do bot (peça ao @BotFather no Telegram)
TELEGRAM_TOKEN=

# IDs autorizados, separados por vírgula (descubra o seu com @userinfobot)
# Use "*" para liberar para qualquer usuário (cuidado: bot fica público!)
ALLOWED_USER_IDS=123456789,987654321

# Altura máxima de vídeo oferecida (1080, 720, 480, 360)
MAX_HEIGHT=720

# ----- Cookies do YouTube (necessário em VPS p/ driblar "confirm you're not a bot") -----
# Exporte cookies.txt de uma conta DESCARTÁVEL e cole aqui em base64:
#   base64 -w0 cookies.txt   (Linux)  /  base64 -i cookies.txt   (macOS)
YOUTUBE_COOKIES_B64=
# Alternativa: caminho de um arquivo cookies.txt montado no container
# COOKIES_FILE=/data/cookies.txt
# Opcional: forçar clients (ex.: android,ios,web) se ainda houver bloqueio
# YT_PLAYER_CLIENT=
# Alternativa aos cookies: proxy de IP residencial (cobra por GB!)
# YT_PROXY=http://usuario:senha@host:porta

# ----- Opcional: server Bot API local para arquivos até 2 GB -----
# Obtenha api_id e api_hash em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
